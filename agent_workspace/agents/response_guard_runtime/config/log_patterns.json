{
    "description": "Log patterns for smart filtering to reduce volume for LLM consumption",
    "capturePatterns": {
        "network_request": {
            "patterns": [
                "⬆️",
                "Sending request to",
                "POST ",
                "GET "
            ],
            "priority": "high",
            "description": "Outgoing API requests"
        },
        "network_response": {
            "patterns": [
                "⬇️",
                "Response received",
                "Status:"
            ],
            "priority": "high",
            "description": "Incoming API responses"
        },
        "parse_success": {
            "patterns": [
                "ResponseParser.parse",
                "fromJson",
                "parsed successfully"
            ],
            "priority": "medium",
            "description": "Successful response parsing"
        },
        "parse_error": {
            "patterns": [
                "parsing_error",
                "Failed to parse",
                "FormatException",
                "type '.*' is not a subtype"
            ],
            "priority": "critical",
            "description": "Response parsing failures"
        },
        "network_error": {
            "patterns": [
                "DioException",
                "timeout_error",
                "connection_error",
                "server_error"
            ],
            "priority": "critical",
            "description": "Network-level errors"
        },
        "api_error": {
            "patterns": [
                "invalid-argument",
                "not-found",
                "unauthenticated",
                "permission-denied",
                "failed-precondition"
            ],
            "priority": "high",
            "description": "API-level errors"
        }
    },
    "excludePatterns": {
        "verbose": [
            "[verbose]",
            "[debug]",
            "flutter:",
            "Observatory"
        ],
        "noise": [
            "Reloaded",
            "Hot restart",
            "Syncing files",
            "DevTools"
        ],
        "system": [
            "Launching lib/main.dart",
            "Running Gradle",
            "Xcode build"
        ]
    },
    "truncation": {
        "maxResponseBodyChars": 500,
        "maxStackTraceLines": 5,
        "maxRepeatedErrors": 3
    },
    "outputFormat": {
        "timestampFormat": "ISO8601",
        "includeLineNumbers": false,
        "groupByEndpoint": true
    }
}