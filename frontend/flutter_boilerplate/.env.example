# Copy to `.env`, then run: dart run build_runner build --delete-conflicting-outputs
# (envied reads this file to generate the gitignored lib/env.g.dart)

# Base URL of the Plattr Cloud Functions the consumer app talks to.
# Default = local Firebase emulator (functions port 5002, project rms-app-dd875).
SERVER_URL=http://localhost:5002/rms-app-dd875/us-central1
