
{
    "folders": [
    { "path": "backend/src-plattr",         "name": "backend"  },
    { "path": "frontend/flutter_boilerplate","name": "consumer" },
    { "path": "frontend/src-platter-apps/apps/platter_admin",      "name": "admin"    },
    { "path": "frontend/src-platter-apps/apps/platter_kitchen",    "name": "kitchen"  },
    { "path": "frontend/src-platter-apps/apps",     "name": "server"   }
  ],

    "settings": {
      "search.exclude": {
        "**/node_modules": true,
        "**/build": true,
        "**/.dart_tool": true,
        "**/.venv": true
      },
      "files.watcherExclude": {
        "**/node_modules/**": true,
        "**/build/**": true,
        "**/.dart_tool/**": true,
        "**/.venv/**": true
      },
      "[dart]": {
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
			"source.fixAll": "explicit",
			"source.organizeImports": "explicit"
		}
      },
      "editor.rulers": [100]
    },

    "tasks": {
        "version": "2.0.0",
        "tasks": [
          {
            "label": "backend:dev",
            "type": "shell",
            "command": "npm run dev",
            "options": {
              "cwd": "${workspaceFolder:backend}"
            },
            "isBackground": true,
            "problemMatcher": []
          },
          {
            "label": "consumer:chrome",
            "type": "shell",
            "command": "flutter run -d chrome --web-port=5100",
            "options": {
              "cwd": "${workspaceFolder:consumer}"
            }
          },
          {
            "label": "admin:chrome",
            "type": "shell",
            "command": "flutter run -d chrome --web-port=5101",
            "options": {
              "cwd": "${workspaceFolder:admin}"
            }
          },
          {
            "label": "kitchen:chrome",
            "type": "shell",
            "command": "flutter run -d chrome --web-port=5102",
            "options": {
              "cwd": "${workspaceFolder:kitchen}"
            }
          },
          {
            "label": "server:chrome",
            "type": "shell",
            "command": "flutter run -d chrome --web-port=5103",
            "options": {
              "cwd": "${workspaceFolder:server}"
            }
          }
        ]
      },

    "launch":{
        "version": "0.2.0",
        "configurations": [
          {
            "name": "Consumer (Flutter)",
            "type": "dart",
            "request": "launch",
            "cwd": "${workspaceFolder:consumer}",
            "program": "lib/main.dart"
          },
          {
            "name": "Admin (Flutter)",
            "type": "dart",
            "request": "launch",
            "cwd": "${workspaceFolder:admin}",
            "program": "lib/main.dart"
          },
          {
            "name": "Kitchen (Flutter)",
            "type": "dart",
            "request": "launch",
            "cwd": "${workspaceFolder:kitchen}",
            "program": "lib/main.dart"
          },
          {
            "name": "Server (Flutter)",
            "type": "dart",
            "request": "launch",
            "cwd": "${workspaceFolder:server}",
            "program": "lib/main.dart"
          }
        ],
        "compounds": [
          {
            "name": "Run backend + consumer",
            "configurations": ["Consumer (Flutter)"],
            "preLaunchTask": "backend:dev"
          },
          {
            "name": "Run backend + admin",
            "configurations": ["Admin (Flutter)"],
            "preLaunchTask": "backend:dev"
          },
          {
            "name": "Run backend + kitchen",
            "configurations": ["Kitchen (Flutter)"],
            "preLaunchTask": "backend:dev"
          },
          {
            "name": "Run backend + server",
            "configurations": ["Server (Flutter)"],
            "preLaunchTask": "backend:dev"
          }
        ]
      }
  }
  