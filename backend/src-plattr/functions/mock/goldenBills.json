    "food": {
      "label": "GST",
      "mode": "exclusive",
      "collect": true,
      "parts": [
        {
          "label": "CGST",
          "rateBps": 250
        },
        {
          "label": "SGST",
          "rateBps": 250
        }
      ]
    },
    "liquor": {
      "label": "Liquor",
      "mode": "inclusive",
      "collect": true,
      "parts": []
    },
    "partRounding": "independent",
    "roundTo": 100
  },
